    window.onload = function() {
      renderCourses();
      updatePlannerUI();
    };

    // Render Course Cards into Timeline Columns
    function renderCourses() {
      // Clear all sections
      document.getElementById('group-1-1').innerHTML = '';
      document.getElementById('group-1-2').innerHTML = '';
      document.getElementById('group-2-1').innerHTML = '';
      document.getElementById('group-2-2').innerHTML = '';
      document.getElementById('group-3-1').innerHTML = '';
      document.getElementById('group-3-2').innerHTML = '';

      const query = document.getElementById('search-input').value.toLowerCase();
      const catFilter = document.getElementById('category-filter').value;

      courses.forEach(course => {
        // Apply text query filter
        const matchQuery = course.title.toLowerCase().includes(query) || course.description.toLowerCase().includes(query);
        // Apply category filter
        const matchCat = catFilter === "all" || course.category === catFilter;

        if (matchQuery && matchCat) {
          const cardHtml = createCourseCard(course);
          const targetGroup = document.getElementById(`group-${course.group}`);
          if (targetGroup) {
            targetGroup.insertAdjacentHTML('beforeend', cardHtml);
          }
        }
      });
    }

    // Generate Card HTML Structure with responsive styling
    function createCourseCard(course) {
      const isSelected = selectedCamps.includes(course.id);
      const isHighlight = activeTrack === "all" || course.tracks.includes(activeTrack);
      
      const categoryColorMap = {
        'Programming': 'text-emerald-500 bg-emerald-50 border-emerald-100',
        'AI': 'text-blue-500 bg-blue-50 border-blue-100',
        'Humanoid': 'text-amber-500 bg-amber-50 border-amber-100',
        'Semiconductor': 'text-purple-500 bg-purple-50 border-purple-100'
      };

      const dimClass = isHighlight ? 'opacity-100 scale-100' : 'opacity-40 scale-95 saturate-50 hover:opacity-80';
      const borderClass = isSelected ? 'border-indigo-500 ring-2 ring-indigo-500/20 bg-indigo-50/10' : 'border-slate-200 bg-white hover:border-slate-300';
      
      return `
        <div id="card-${course.id}" class="card-element p-4 rounded-xl border transition-all duration-300 flex flex-col justify-between shadow-sm relative group ${dimClass} ${borderClass}">
          
          <!-- Category and Control Row -->
          <div class="flex items-center justify-between mb-2">
            <span class="text-[10px] font-bold px-2 py-0.5 rounded border flex items-center gap-1 ${categoryColorMap[course.category]}">
              <i class="${course.categoryIcon}"></i> ${getCategoryLabel(course.category)}
            </span>
            <span class="text-[10px] font-bold px-2 py-0.5 rounded-full border ${course.difficultyColor}">
              ${course.difficultyText}
            </span>
          </div>

          <!-- Title -->
          <h4 class="font-bold text-slate-800 text-sm group-hover:text-blue-600 transition-colors cursor-pointer flex items-center gap-1.5" onclick="openDetails('${course.id}')">
            ${course.title}
            <i class="fa-solid fa-arrow-up-right-from-square text-[10px] opacity-0 group-hover:opacity-100 transition-all text-slate-400"></i>
          </h4>

          <!-- Sub-info -->
          <p class="text-xs text-slate-500 mt-1.5 line-clamp-2 leading-relaxed">
            ${course.description}
          </p>

          <!-- Divider -->
          <div class="border-t border-slate-100 my-3"></div>

          <!-- Bottom Add/Remove actions -->
          <div class="flex items-center justify-between">
            <span class="text-[10px] font-semibold text-slate-400 flex items-center gap-1">
              <i class="fa-solid fa-clock"></i> ${course.semesterText}
            </span>
            
            ${isSelected ? 
              `<button onclick="togglePlanner('${course.id}')" class="bg-indigo-600 text-white hover:bg-rose-600 p-1.5 px-3 rounded-lg text-xs font-bold transition-all flex items-center gap-1 group/btn">
                <i class="fa-solid fa-check group-hover/btn:hidden"></i>
                <i class="fa-solid fa-trash-can hidden group-hover/btn:inline text-[10px]"></i>
                <span class="group-hover/btn:hidden">선택됨</span>
                <span class="hidden group-hover/btn:inline">삭제</span>
              </button>` : 
              `<button onclick="togglePlanner('${course.id}')" class="bg-slate-100 text-slate-700 hover:bg-indigo-50 hover:text-indigo-600 p-1.5 px-3 rounded-lg text-xs font-bold transition-all flex items-center gap-1">
                <i class="fa-solid fa-plus text-[10px]"></i> 담기
              </button>`
            }
          </div>
        </div>
      `;
    }

    // Helper translation for Korean Labels
    function getCategoryLabel(category) {
      const map = {
        'Programming': '프로그래밍',
        'AI': '인공지능',
        'Humanoid': '휴머노이드',
        'Semiconductor': '반도체'
      };
      return map[category] || category;
    }

    // Toggle Track Highlights
    function selectTrack(trackId) {
      activeTrack = trackId;
      document.querySelectorAll('.track-btn').forEach(btn => {
        btn.classList.remove('active', 'bg-slate-900', 'text-white', 'shadow-md');
        btn.classList.add('bg-slate-100', 'text-slate-700');
      });

      const activeBtn = document.getElementById(`track-btn-${trackId}`);
      activeBtn.classList.add('active', 'bg-slate-900', 'text-white', 'shadow-md');
      activeBtn.classList.remove('bg-slate-100', 'text-slate-700');

      // Update Track Label inside Planner Panel
      const labelMap = {
        'all': '🌐 전체 자유 코스 설계',
        'ai': '🤖 AI & SW 개발자 트랙',
        'robot': '🦾 로봇 & 임베디드 트랙',
        'semi': '💾 반도체 설계 트랙'
      };
      document.getElementById('target-track-label').innerText = labelMap[trackId];

      renderCourses();
    }

    // Global Search & Dropdown Filter trigger
    function filterCourses() {
      renderCourses();
    }

    // Add/Remove item inside simulated planner array
    function togglePlanner(courseId) {
      const index = selectedCamps.indexOf(courseId);
      const course = courses.find(c => c.id === courseId);

      if (index === -1) {
        // Prevent overflow
        if (selectedCamps.length >= 10) {
          showToast("최대 10개까지만 로드맵에 담을 수 있습니다.");
          return;
        }
        selectedCamps.push(courseId);
        showToast(`'${course.title}' 캠프가 로드맵에 반영되었습니다!`);
      } else {
        selectedCamps.splice(index, 1);
        showToast(`'${course.title}' 캠프를 삭제했습니다.`);
      }

      // Save and update
      localStorage.setItem('ai_focus_selected_camps', JSON.stringify(selectedCamps));
      renderCourses();
      updatePlannerUI();
    }

    // Update Simulated Planner Dashboard Details
    function updatePlannerUI() {
      const selectedCount = selectedCamps.length;
      document.getElementById('selected-count').innerText = selectedCount;
      document.getElementById('validation-count').innerText = `${selectedCount} / 8개`;

      // Update Progress Bar (Perfect threshold is 7~8 camps)
      let percent = (selectedCount / 8) * 100;
      if (percent > 100) percent = 100;
      document.getElementById('planner-progress').style.width = `${percent}%`;

      // Update Top Status Badge
      const statusBadge = document.getElementById('planner-status-badge');
      if (selectedCount >= 7 && selectedCount <= 8) {
        statusBadge.className = "text-[10px] font-bold px-2 py-0.5 rounded-full bg-emerald-100 text-emerald-800 border border-emerald-200";
        statusBadge.innerHTML = "이수 충족 ✔️";
      } else if (selectedCount > 8) {
        statusBadge.className = "text-[10px] font-bold px-2 py-0.5 rounded-full bg-rose-100 text-rose-800 border border-rose-200";
        statusBadge.innerHTML = "초과 선택 ⚠️";
      } else {
        statusBadge.className = "text-[10px] font-bold px-2 py-0.5 rounded-full bg-amber-100 text-amber-800 border border-amber-200";
        statusBadge.innerHTML = "이수 부족 ⏳";
      }

      // Render Selected Items List on the Sidebar Panel
      const listContainer = document.getElementById('planner-list');
      listContainer.innerHTML = '';

      if (selectedCamps.length === 0) {
        listContainer.innerHTML = `
          <div class="text-center py-8 text-slate-400 border border-dashed border-slate-200 rounded-xl text-xs">
            <i class="fa-solid fa-folder-open text-xl mb-1.5 block text-slate-300"></i>
            교과목 옆의 <i class="fa-solid fa-plus text-[10px]"></i> 버튼을 눌러<br>이수 계획표에 담아보세요.
          </div>
        `;
      } else {
        // Sort selected camps by their timeline sequence for readable timeline view
        const sortedSelected = courses.filter(c => selectedCamps.includes(c.id));
        sortedSelected.forEach(course => {
          listContainer.insertAdjacentHTML('beforeend', `
            <div class="flex items-center justify-between p-2.5 bg-slate-50 rounded-lg border border-slate-200 hover:border-indigo-300 transition-all text-xs">
              <div class="flex-1 min-w-0 pr-2">
                <p class="font-bold text-slate-800 truncate">${course.title}</p>
                <p class="text-[10px] text-indigo-500 font-semibold">${course.semesterText}</p>
              </div>
              <button onclick="togglePlanner('${course.id}')" class="text-slate-400 hover:text-rose-500 p-1 transition-colors">
                <i class="fa-solid fa-circle-xmark text-sm"></i>
              </button>
            </div>
          `);
        });
      }

      validateRules();
    }

    // Rules Validation & Verification logic
    function validateRules() {
      const selected = courses.filter(c => selectedCamps.includes(c.id));
      const hasProg = selected.some(c => c.category === 'Programming');
      const hasAI = selected.some(c => c.category === 'AI');
      const count = selected.length;

      // Rule 1: 7~8 count check
      const ruleQty = document.getElementById('rule-qty');
      if (count >= 7 && count <= 8) {
        ruleQty.className = "flex items-center gap-1.5 text-emerald-600 font-bold";
        ruleQty.innerHTML = '<i class="fa-solid fa-circle-check"></i> 최소 7개 ~ 최대 8개 선택 (통과)';
      } else {
        ruleQty.className = "flex items-center gap-1.5 text-slate-400";
        ruleQty.innerHTML = '<i class="fa-regular fa-circle"></i> 최소 7개 ~ 최대 8개 선택';
      }

      // Rule 2: Programming included
      const ruleProg = document.getElementById('rule-prog');
      if (hasProg) {
        ruleProg.className = "flex items-center gap-1.5 text-emerald-600 font-bold";
        ruleProg.innerHTML = '<i class="fa-solid fa-circle-check"></i> 프로그래밍 분야 포함 이수 (통과)';
      } else {
        ruleProg.className = "flex items-center gap-1.5 text-slate-400";
        ruleProg.innerHTML = '<i class="fa-regular fa-circle"></i> 프로그래밍 분야 포함 이수';
      }

      // Rule 3: AI included
      const ruleAi = document.getElementById('rule-ai');
      if (hasAI) {
        ruleAi.className = "flex items-center gap-1.5 text-emerald-600 font-bold";
        ruleAi.innerHTML = '<i class="fa-solid fa-circle-check"></i> 인공지능 분야 필수 이수 (통과)';
      } else {
        ruleAi.className = "flex items-center gap-1.5 text-slate-400";
        ruleAi.innerHTML = '<i class="fa-regular fa-circle"></i> 인공지능 분야 필수 이수';
      }

      // Final Alert Status box
      const alertBox = document.getElementById('graduation-alert-box');
      const alertText = document.getElementById('graduation-alert-text');

      if (count >= 7 && count <= 8 && hasProg && hasAI) {
        alertBox.className = "p-3 rounded-xl bg-emerald-50 border border-emerald-200 text-center text-emerald-800";
        alertText.innerHTML = "🎉 <strong>졸업 이수 설계 완벽 충족!</strong> <br><span class='text-[10px] block mt-1'>종합전형 수시전형 생기부에 강력한 커스텀 기술 경쟁력이 증명될 것입니다.</span>";
      } else if (count > 8) {
        alertBox.className = "p-3 rounded-xl bg-rose-50 border border-rose-200 text-center text-rose-800";
        alertText.innerHTML = "⚠️ <strong>이수 학점 한도 초과!</strong> <br><span class='text-[10px] block mt-0.5'>졸업 최대 가능 방과후 수는 8개입니다. 최적화를 권장합니다.</span>";
      } else {
        alertBox.className = "p-3 rounded-xl bg-slate-50 border border-slate-200 text-center text-slate-500";
        alertText.innerHTML = "위 규칙을 달성하도록<br>교과를 조율해 계획해 보세요.";
      }
    }

    // Reset simulator
    function resetPlanner() {
      selectedCamps = [];
      localStorage.removeItem('ai_focus_selected_camps');
      renderCourses();
      updatePlannerUI();
      showToast("이수 시뮬레이터가 초기화되었습니다.");
    }

    // Modal Display Trigger
    function openDetails(courseId) {
      const course = courses.find(c => c.id === courseId);
      if (!course) return;

      document.getElementById('modal-category').innerText = getCategoryLabel(course.category);
      document.getElementById('modal-title').innerText = course.title;
      document.getElementById('modal-semester').innerText = `🗓️ 추천 수강시기 : ${course.semesterText}`;
      
      const diffTag = document.getElementById('modal-difficulty');
      diffTag.innerText = course.difficultyText;
      diffTag.className = `inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full text-xs font-semibold ${course.difficultyColor}`;

      document.getElementById('modal-desc').innerText = course.description;
      document.getElementById('modal-tools').innerHTML = `<i class="fa-solid fa-cube text-indigo-500"></i> ${course.tools}`;
      document.getElementById('modal-portfolio').innerHTML = course.portfolio.replace(/\n/g, '<br>');

      // Update Add/Remove Button inside modal
      const isSelected = selectedCamps.includes(course.id);
      const addBtn = document.getElementById('modal-add-btn');
      
      if (isSelected) {
        addBtn.className = "bg-rose-600 text-white font-bold px-4 py-2 rounded-lg text-xs hover:bg-rose-500 transition-all shadow-md";
        addBtn.innerHTML = '<i class="fa-solid fa-trash-can"></i> 내 계획안에서 제외';
        addBtn.onclick = function() {
          togglePlanner(course.id);
          openDetails(course.id); // re-refresh state inside modal
        };
      } else {
        addBtn.className = "bg-indigo-600 text-white font-bold px-4 py-2 rounded-lg text-xs hover:bg-indigo-500 transition-all shadow-md";
        addBtn.innerHTML = '<i class="fa-solid fa-plus"></i> 내 로드맵에 추가';
        addBtn.onclick = function() {
          togglePlanner(course.id);
          openDetails(course.id);
        };
      }

      // Display animated Modal
      const modal = document.getElementById('detail-modal');
      modal.classList.remove('hidden');
      setTimeout(() => {
        modal.classList.remove('opacity-0');
        modal.querySelector('div').classList.remove('scale-95');
      }, 10);
    }

    // Modal Close Trigger
    function closeModal() {
      const modal = document.getElementById('detail-modal');
      modal.classList.add('opacity-0');
      modal.querySelector('div').classList.add('scale-95');
      setTimeout(() => {
        modal.classList.add('hidden');
      }, 300);
    }

    // Notification toast alert
    function showToast(message) {
      const toast = document.getElementById('toast');
      document.getElementById('toast-message').innerText = message;
      toast.classList.remove('opacity-0', 'translate-y-20');
      toast.classList.add('opacity-100', 'translate-y-0');

      setTimeout(() => {
        toast.classList.remove('opacity-100', 'translate-y-0');
        toast.classList.add('opacity-0', 'translate-y-20');
      }, 2500);
    }

    // Copy formatted plan results to clipboard
    function exportPlan() {
      if (selectedCamps.length === 0) {
        showToast("로드맵에 한 개 이상의 과목을 담아야 복사할 수 있습니다.");
        return;
      }

      const sortedSelected = courses.filter(c => selectedCamps.includes(c.id));
      let text = `=== 인공지능 중점반 방과후 캠프 3개년 설계안 ===\n`;
      text += `선택된 타겟 경로: ${document.getElementById('target-track-label').innerText}\n`;
      text += `총 이수 캠프 개수: ${sortedSelected.length}개\n\n`;
      
      sortedSelected.forEach((course, index) => {
        text += `${index + 1}. [${course.semesterText}] ${course.title} (${getCategoryLabel(course.category)} | 난이도: ${course.difficultyText})\n`;
      });
      
      text += `\n플래너 규칙 충족 여부:\n`;
      text += `- 7~8개 이수 규칙: ${sortedSelected.length >= 7 && sortedSelected.length <= 8 ? '충족' : '비충족'}\n`;
      text += `- 프로그래밍 포함 여부: ${sortedSelected.some(c => c.category === 'Programming') ? '충족' : '비충족'}\n`;
      text += `- 인공지능 포함 여부: ${sortedSelected.some(c => c.category === 'AI') ? '충족' : '비충족'}\n`;
      text += `==============================================`;

      // Copy using document.execCommand fallback as per instructions
      const tempTextArea = document.createElement('textarea');
      tempTextArea.value = text;
      document.body.appendChild(tempTextArea);
      tempTextArea.select();
      document.execCommand('copy');
      document.body.removeChild(tempTextArea);

      showToast("내 설계 계획안이 클립보드에 텍스트로 저장되었습니다.");
    }
  </script>
</body>
</html>
